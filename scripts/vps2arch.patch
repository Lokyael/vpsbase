+fix_network_manager() {
+    for file in /etc/NetworkManager/system-connections/cloud-init-eth*.nmconnection; do
+        [ -f "$file" ] || continue
+        mac=$(grep ^mac-address= "$file" | cut -d= -f2 | grep .) || continue
+        ethx=$(get_ethx_by_mac "$mac") || continue
