+        error "SSH 端口无效：$1"
+        return 1
+    fi
+    if [[ "$1" == 443 ]]; then
+        error '443/tcp 预留给业务入口，请选择其他 SSH 端口。'
+        return 1
+    fi
+}
+
+assert_arch_ssh_port() {
+    check_arch_ssh_port "$1" || exit 1
+}
+
+valid_ed25519_key() {
+    [[ "$1" != *$'\n'* && "$1" =~ ^ssh-ed25519[[:blank:]]+[A-Za-z0-9+/]{68}([[:blank:]].*)?$ ]] &&
+        ssh-keygen -lf /dev/stdin <<< "$1" >/dev/null 2>&1
