+
+validate_arch_keys() {
+    local key found=0
+    while IFS= read -r key; do
+        key=${key%$'\r'}
+        [[ "$key" =~ ^[[:blank:]]*(#.*)?$ ]] && continue
+        valid_ed25519_key "$key" || return 1
+        found=1
+    done <<< "$1"
+    (( found ))
